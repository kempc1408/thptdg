<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'THPT Dầu Giây - Cổng Thông Tin Điện Tử' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        hust: {
                            red: '#990000',
                            darkred: '#750000',
                            gold: '#D4AF37'
                        }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Roboto', sans-serif; }
        .bg-hust-red { background-color: #990000; }
        .bg-hust-darkred { background-color: #750000; }
        .text-hust-red { color: #990000; }
        .border-hust-red { border-color: #990000; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        .bg-pattern {
            background-image: radial-gradient(#990000 0.5px, transparent 0.5px), radial-gradient(#990000 0.5px, #f1f5f9 0.5px);
            background-size: 20px 20px;
            background-position: 0 0, 10px 10px;
        }
        html.dark .bg-pattern {
            background-image: radial-gradient(#f87171 0.5px, transparent 0.5px), radial-gradient(#f87171 0.5px, #0f172a 0.5px);
            background-size: 20px 20px;
            background-position: 0 0, 10px 10px;
        }

        .card-custom-shadow {
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.12), 0 10px 10px -5px rgba(0, 0, 0, 0.06);
        }

        html.dark .text-hust-red { color: #f87171 !important; }
        html.dark .border-hust-red { border-color: #f87171 !important; }
        html.dark h3 .text-hust-red,
        html.dark h4 .text-hust-red,
        html.dark .dark-title-gold { color: #facc15 !important; }

        @keyframes popIn {
            0% { opacity: 0; transform: scale(0.95); }
            100% { opacity: 1; transform: scale(1); }
        }
        .animate-pop-in { animation: popIn 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }

        .club-transition { transition: opacity 0.35s ease-in-out, transform 0.35s ease-in-out; }
        .club-fade-out { opacity: 0.2; transform: scale(0.98); }

        .dropdown-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
            pointer-events: none;
        }
        .group:hover .dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            pointer-events: auto;
        }
    </style>
</head>